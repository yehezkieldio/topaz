{
  "name": "topaz-tether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "bun run scripts/sync-env-setup.ts",
    "dev": "next dev",
    "build": "next build",
    "prestart": "bun run scripts/sync-env-setup.ts",
    "start": "next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/sync-cli.ts",
    "verify:auth-roles": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/verify-auth-roles.ts",
    "verify:authoring-flow": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/verify-authoring-flow.ts",
    "verify": "bun run verify:auth-roles && bun run verify:authoring-flow",
    "export-stats": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/export-stats.ts",
    "prune-observations": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/prune-observations.ts",
    "import:reading-tracker": "bun --preload ./scripts/lib/next-runtime-mock.ts scripts/import-reading-tracker.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "fast-xml-parser": "^5.8.0",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-bun-compile": "^2.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0",
    "vitest": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "packageManager": "bun@1.4.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
