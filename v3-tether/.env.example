# Absolute path to this device's local SQLite file. One file per device --
# there is no shared connection string (03_data/00_schema_contract.md).
DATABASE_PATH="./topaz.db"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# No social OAuth provider (02_stack/04_auth_and_authorization.md) -- auth is
# local credential/passkey only, so a device can unlock its own library with
# no internet reachable. Sign-up is limited to a single account at the
# application layer, not via an external allow-list.
