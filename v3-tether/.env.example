# Absolute path to this device's local SQLite file. One file per device --
# there is no shared connection string (03_data/00_schema_contract.md).
DATABASE_PATH="./topaz.db"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# No social OAuth provider (02_stack/04_auth_and_authorization.md) -- auth is
# local credential/passkey only, so a device can unlock its own library with
# no internet reachable. Sign-up is limited to a single account at the
# application layer, not via an external allow-list.

# This device's own Tailscale hostname and the port /api/sync is reachable
# on -- embedded in the pairing code this device generates
# (08_sync/01_transport_and_pairing.md). `bun dev`/`bun start` auto-fill
# these from `tailscale status --json` if missing (scripts/sync-env-setup.ts)
# -- only set them by hand if that detection fails or you need to override it.
SYNC_TAILNET_HOSTNAME="this-device.your-tailnet.ts.net"
SYNC_PORT="3000"
