{
  "name": "topaz",
  "version": "0.5.13",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "ultracite check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:prepare:v2": "bun run scripts/prepare-v2-database.ts",
    "db:push": "drizzle-kit push",
    "db:seed:v2": "SKIP_ENV_VALIDATION=1 bun run scripts/seed-v2-reference-data.ts",
    "db:seed:v2:fixture": "SKIP_ENV_VALIDATION=1 bun run scripts/seed-v2-fixture.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "fix": "ultracite fix .",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome lint . --fix --unsafe",
    "start": "next start",
    "typecheck": "bunx tsc --noEmit",
    "verify:v2:admin": "bun run scripts/verify-v2-admin-flow.ts",
    "verify:v2:browser-admin": "bun run scripts/verify-v2-browser-admin.ts",
    "verify:v2:public": "bun run scripts/verify-v2-public-library.ts"
  },
